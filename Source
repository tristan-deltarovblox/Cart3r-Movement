
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local humanoid

local speedValue = 16
local jumpValue = 50

local function applyMovement()
    if humanoid then
        humanoid.WalkSpeed = speedValue
        humanoid.UseJumpPower = true
        humanoid.JumpPower = jumpValue
    end
end

local function setupCharacter(character)
    humanoid = character:WaitForChild("Humanoid")
    applyMovement()
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
    setupCharacter(player.Character)
end

local function createSlider(parent, labelText, min, max, default, callback, y)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 24)
    label.Position = UDim2.fromOffset(0, y)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, 0, 0, 12)
    bar.Position = UDim2.fromOffset(0, y + 32)
    bar.BackgroundColor3 = Color3.fromRGB(55, 25, 30)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = parent

    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.BackgroundColor3 = Color3.fromRGB(255, 35, 65)
    fill.Size = UDim2.fromScale((default-min)/(max-min), 1)
    fill.Parent = bar

    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dragging = false

    local function update(input)
        local percentage = math.clamp(
            (input.Position.X - bar.AbsolutePosition.X)
            / bar.AbsoluteSize.X, 0, 1
        )

        local value = math.floor(
            min + percentage * (max-min) + 0.5
        )

        fill.Size = UDim2.fromScale(percentage, 1)
        label.Text = labelText .. ": " .. value

        callback(value)
    end

    label.Text = labelText .. ": " .. default

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            update(input)
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Example:
-- Create a ScreenGui and parent frame before calling these.

local gui = Instance.new("ScreenGui")
gui.Name = "CART3RSliders"
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Size = UDim2.fromOffset(280, 140)
panel.Position = UDim2.new(0.5, -140, 0.5, -70)
panel.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
panel.Parent = gui

createSlider(panel, "SPEED", 0, 500, 16, function(value)
    speedValue = value
    applyMovement()
end, 8)

createSlider(panel, "JUMP", 0, 500, 50, function(value)
    jumpValue = value
    applyMovement()
end, 72)
